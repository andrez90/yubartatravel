# --- Supabase (panel administrativo y contenido) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica
# Solo servidor (NUNCA con NEXT_PUBLIC_). Se usa para guardar solicitudes, reservas y consentimientos.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=https://yubartatravels.com
# Google Analytics 4 (solo carga tras aceptar cookies). Opcional.
NEXT_PUBLIC_GA_ID=
# Interruptor de emergencia: pon 1 para pausar el formulario si hay abuso
CONTACT_PAUSED=0

# --- Pagos en línea con Wompi (opcional; solo servidor). Sin esto, el botón de Wompi no se puede activar. ---
# Se crean en el panel de Wompi (comercios.wompi.co). Usa las de PRUEBA primero.
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
